{
  "name": "@freddy03h/lenses-ppx",
  "version": "7.0.0",
  "description": "ReScript 12 PPX that generates GADT lenses for record types",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Freddy03h/lenses-ppx.git",
    "directory": "packages/ppx"
  },
  "keywords": [
    "ReScript",
    "ppx",
    "lenses",
    "GADT"
  ],
  "scripts": {
    "postinstall": "node postinstall.js",
    "build": "dune build",
    "build:static": "dune build --profile static"
  },
  "files": [
    "/postinstall.js",
    "/ppx",
    "/ppx.cmd",
    "/ppx-linux-x64.exe",
    "/ppx-linux-arm64.exe",
    "/ppx-osx-x64.exe",
    "/ppx-osx-arm64.exe",
    "/ppx-windows.exe"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "rescript": "^12.0.0"
  }
}
